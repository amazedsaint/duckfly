```js
await (async (page) => {
  const receipt=[];
  const assert=(condition,message)=>{if(!condition)throw Error(message);};
  const telemetry=()=>page.evaluate(()=>window.duckflyTelemetry);
  await page.waitForFunction(()=>window.duckflyTelemetry?.ready,{timeout:30000});
  const run=async seconds=>{
    const start=(await telemetry()).time;
    await page.getByRole('button',{name:'▶ Run',exact:true}).click();
    await page.waitForFunction(t=>window.duckflyTelemetry?.time>=t,start+seconds,{timeout:30000});
    await page.getByRole('button',{name:'Ⅱ Pause',exact:true}).click();
    await page.waitForFunction(()=>window.duckflyTelemetry?.paused);
    return telemetry();
  };
  const preset=async name=>{
    await page.getByRole('combobox',{name:'Experiment preset'}).selectOption(name);
    await page.waitForFunction(()=>window.duckflyTelemetry?.time===0&&window.duckflyTelemetry?.paused);
  };
  await preset('target');
  let t=await run(6);
  assert(t.ducks[0].position[0]>.25,'Duck must approach the target through camera input');
  assert(!t.ducks[0].fallen,'Target following must stay upright');
  assert(t.agents['duck-1'].vision.target.visible,'Target must remain detected');
  receipt.push({check:'camera-driven approach',x:t.ducks[0].position[0],distance:t.ducks[0].distance});
  const frozen=t.time;await page.waitForTimeout(200);assert((await telemetry()).time===frozen,'Pause must freeze both clocks');
  await page.getByRole('checkbox',{name:'Active head looking'}).check();
  const headBefore=t.ducks[0].headPose;
  t=await run(1);assert(t.ducks[0].headPose.some((v,i)=>v!==headBefore[i]),'Physical head pose must change');
  receipt.push({check:'active head control',fallen:t.ducks[0].fallen});
  await page.getByRole('combobox',{name:'Silence',exact:true}).selectOption('output');
  t=await run(.2);assert(t.ducks[0].command.every(v=>v===0),'Output intervention must stop both intents');
  receipt.push({check:'output intervention',command:t.ducks[0].command});
  const history=t.history;
  await page.getByRole('slider',{name:'Rewind to checkpoint'}).fill('2');
  await page.getByRole('slider',{name:'Rewind to checkpoint'}).dispatchEvent('change');
  await page.waitForFunction(time=>Math.abs(window.duckflyTelemetry.time-time)<1e-8,history[2].time);
  await page.getByRole('button',{name:'Branch here',exact:true}).click();
  await page.waitForFunction(()=>window.duckflyTelemetry.branch>0);
  receipt.push({check:'rewind and branch',time:(await telemetry()).time});
  await preset('occlusion');t=await run(.5);
  assert(!t.agents['duck-1'].vision.target.visible,'A physical wall must occlude the target');
  assert(t.ducks[0].command[0]===0,'Occlusion must remove forward target intent');
  receipt.push({check:'visual occlusion',target:t.agents['duck-1'].vision.target});
  await preset('flock');t=await run(2);
  assert(t.ducks.length===3,'Flock preset must have independent ducks');
  assert(t.ducks.slice(1).some(d=>t.agents[d.id].vision.neighbor.visible),'At least one companion must be seen through camera pixels');
  receipt.push({check:'multiple duck vision',ducks:t.ducks.map(d=>({id:d.id,distance:d.distance,neighbor:t.agents[d.id].vision.neighbor.visible}))});
  await page.getByRole('combobox',{name:'Object to add'}).selectOption('ball');
  await page.getByRole('button',{name:'＋ Add',exact:true}).click();
  await page.waitForFunction(()=>window.duckflyTelemetry.scene.props.some(p=>p.kind==='ball'));
  assert(await page.getByLabel('Free physical body').isChecked(),'Added ball must be a physical free body');
  receipt.push({check:'prop editing'});
  await page.getByRole('button',{name:'About the experiment'}).click();
  assert(await page.getByRole('dialog').isVisible(),'About dialog must open');
  await page.getByRole('button',{name:'Close about'}).click();
  await page.screenshot({path:'output/playwright/lab-desktop.png'});
  await page.setViewportSize({width:390,height:844});
  assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'Narrow layout must not overflow horizontally');
  await page.screenshot({path:'output/playwright/lab-mobile.png',fullPage:true});
  await page.setViewportSize({width:1400,height:960});
  return receipt;
})(page);
